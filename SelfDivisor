public class SelfDivisor {
	
	public static boolean isSelfDivisor(int num) {
		int saveNum = num;
		// iterative:
		while(num > 0) {
			if (num % 10 != 0) {
				if (saveNum % (num%10) != 0) {
					return false;
				}
				else num /= 10;
			}
			else return false;
		}
		return true;
		
