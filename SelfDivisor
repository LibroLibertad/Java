		*/
	}
	
	public static int[] firstNumDivisors(int start, int num) {
		int[] selfDivisors = new int[num];
		int startNum = start;
		int index = 0;
		while (index < num) {
			if(isSelfDivisor(startNum)) {
				System.out.println(startNum);
				selfDivisors[index] = startNum;
				index++;
				startNum++;
			}
			else {
				startNum++;
			}
		}
		return selfDivisors;
	}
	
